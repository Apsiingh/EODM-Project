# ==============================================================================
# Enterprise Optical Document Management (EODM) Platform - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=enterprise_ocr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=welcome
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/enterprise_ocr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=welcome

# ------------------------------------------------------------------------------
# JWT Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Must be at least 32 characters / 256 bits for HMAC-SHA
JWT_SECRET=EnterpriseOcrJwtSecretKey32BytesLongMinimumSecretForSigningHmac256!!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Default Seed User Passwords
SEED_ADMIN_PASSWORD=password123
SEED_USER_PASSWORD=password123

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=enterprise-ocr-documents

# ------------------------------------------------------------------------------
# Message Queue & Cache
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Application Ports
# ------------------------------------------------------------------------------
PORT_FRONTEND=3000
PORT_GATEWAY=8080
PORT_AUTH_SERVICE=8081
PORT_OCR_SERVICE=8085
